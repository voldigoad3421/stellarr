/// General settings section
#[component]
fn GeneralSettings() -> impl IntoView {
    view! {
        <section class="settings-section">
            <h2 class="section-title">"General Settings"</h2>

            <div class="card">
                <div class="form-group">
                    <label class="form-label">"Media Root Directory"</label>
                    <input type="text" class="form-input" placeholder="/media" />
                    <small class="form-help">"Root directory for all media files"</small>
                </div>

                <div class="form-group">
                    <label class="form-label">"API Port"</label>
                    <input type="number" class="form-input" placeholder="3000" />
                </div>

                <div class="form-group">
                    <label class="form-label">
                        <input type="checkbox" />
                        " Enable automatic updates"
                    </label>
                </div>

                <div class="form-group">
                    <label class="form-label">
                        <input type="checkbox" />
                        " Enable notifications"
                    </label>
                </div>

                <button class="btn btn-primary">"Save Settings"</button>
            </div>
        </section>
    }
}

/// API Keys configuration section
#[component]
fn ApiKeysSettings() -> impl IntoView {
    let (api_keys, set_api_keys) = create_signal(ApiKeysConfig::default());
    let (test_status, set_test_status) = create_signal(None::<TestResult>);
    let (is_testing, set_is_testing) = create_signal(false);
    let (is_saving, set_is_saving) = create_signal(false);

    // Load API keys
    create_effect(move |_| {
        leptos::spawn_local(async move {
            match ApiClient::get::<ApiKeysConfig>("/api/settings/api-keys").await {
                Ok(data) => set_api_keys.set(data),
                Err(e) => log::error!("Failed to fetch API keys: {}", e),
            }
        });
    });

    // Handle save
    let handle_save = move |_| {
        set_is_saving.set(true);
        let keys = api_keys.get();
        leptos::spawn_local(async move {
            match ApiClient::post("/api/settings/api-keys", &keys).await {
                Ok(_) => {
                    log::info!("API keys saved successfully");
                    set_is_saving.set(false);
                }
                Err(e) => {
                    log::error!("Failed to save API keys: {}", e);
                    set_is_saving.set(false);
                }
            }
        });
    };

    // Handle TMDB test
    let handle_test_tmdb = move |_| {
        set_is_testing.set(true);
        set_test_status.set(None);
        let tmdb_key = api_keys.get().tmdb_access_token;
        leptos::spawn_local(async move {
            match ApiClient::post::<_, TestResult>("/api/settings/api-keys/test/tmdb", &tmdb_key).await {
                Ok(result) => {
                    set_test_status.set(Some(result));
                    set_is_testing.set(false);
                }
                Err(e) => {
                    set_test_status.set(Some(TestResult {
                        success: false,
                        message: format!("Test failed: {}", e),
                    }));
                    set_is_testing.set(false);
                }
            }
        });
    };

    view! {
        <section class="settings-section">
            <div class="section-header">
                <h2 class="section-title">"API Keys"</h2>
                <p class="text-secondary">"Configure external API keys for metadata providers"</p>
            </div>

            <div class="card">
                <div class="form-group">
                    <label class="form-label">
                        "TMDB Access Token"
                        <span class="text-secondary" style="font-weight: normal; margin-left: 8px;">
                            {move || if api_keys.get().tmdb_is_default { "(using default)" } else { "(user-provided)" }}
                        </span>
                    </label>
                    <div style="display: flex; gap: 8px; align-items: flex-start;">
                        <input
                            type="password"
                            class="form-input"
                            style="flex: 1;"
                            placeholder="eyJhbGciOiJIUzI1NiJ9..."
                            prop:value=move || api_keys.get().tmdb_access_token
                            on:input=move |ev| {
                                let value = event_target_value(&ev);
                                set_api_keys.update(|keys| keys.tmdb_access_token = value);
                            }
                        />
                        <button
                            class="btn btn-secondary"
                            style="white-space: nowrap;"
                            on:click=handle_test_tmdb
                            disabled=move || is_testing.get()
                        >
                            {move || if is_testing.get() { "Testing..." } else { "Test" }}
                        </button>
                    </div>
                    <small class="form-help">"Access token for The Movie Database API"</small>
                    <Show when=move || test_status.get().is_some()>
                        <div class={move || {
                            let result = test_status.get().unwrap();
                            if result.success {
                                "alert alert-success"
                            } else {
                                "alert alert-error"
                            }
                        }} style="margin-top: 8px;">
                            {move || test_status.get().unwrap().message}
                        </div>
                    </Show>
                </div>

                <div class="form-group">
                    <label class="form-label">
                        "Have I Been Pwned API Key"
                        <span class="text-secondary" style="font-weight: normal; margin-left: 8px;">
                            {move || if api_keys.get().hibp_is_default { "(using default)" } else { "(user-provided)" }}
                        </span>
                    </label>
                    <input
                        type="password"
                        class="form-input"
                        placeholder="Enter API key..."
                        prop:value=move || api_keys.get().hibp_api_key
                        on:input=move |ev| {
                            let value = event_target_value(&ev);
                            set_api_keys.update(|keys| keys.hibp_api_key = value);
                        }
                    />
                    <small class="form-help">"Optional: API key for Have I Been Pwned breach detection"</small>
                </div>

                <div class="form-group">
                    <label class="form-label">
                        "Fanart.tv API Key"
                        <span class="text-secondary" style="font-weight: normal; margin-left: 8px;">
                            {move || if api_keys.get().fanart_is_default { "(using default)" } else { "(user-provided)" }}
                        </span>
                    </label>
                    <input
                        type="password"
                        class="form-input"
                        placeholder="Enter API key..."
                        prop:value=move || api_keys.get().fanart_api_key
                        on:input=move |ev| {
                            let value = event_target_value(&ev);
                            set_api_keys.update(|keys| keys.fanart_api_key = value);
                        }
                    />
                    <small class="form-help">"Optional: API key for Fanart.tv artwork"</small>
                </div>

                <div class="form-group">
                    <label class="form-label">
                        "OMDb API Key"
                        <span class="text-secondary" style="font-weight: normal; margin-left: 8px;">
                            {move || if api_keys.get().omdb_is_default { "(using default)" } else { "(user-provided)" }}
                        </span>
                    </label>
                    <input
                        type="password"
                        class="form-input"
                        placeholder="Enter API key..."
                        prop:value=move || api_keys.get().omdb_api_key
                        on:input=move |ev| {
                            let value = event_target_value(&ev);
                            set_api_keys.update(|keys| keys.omdb_api_key = value);
                        }
                    />
                    <small class="form-help">"Optional: API key for OMDb (Open Movie Database)"</small>
                </div>

                <div class="form-group">
                    <label class="form-label">
                        "Trakt Client ID"
                        <span class="text-secondary" style="font-weight: normal; margin-left: 8px;">
                            {move || if api_keys.get().trakt_is_default { "(using default)" } else { "(user-provided)" }}
                        </span>
                    </label>
                    <input
                        type="password"
                        class="form-input"
                        placeholder="Enter client ID..."
                        prop:value=move || api_keys.get().trakt_client_id
                        on:input=move |ev| {
                            let value = event_target_value(&ev);
                            set_api_keys.update(|keys| keys.trakt_client_id = value);
                        }
                    />
                    <small class="form-help">"Optional: Client ID for Trakt.tv integration"</small>
                </div>

                <div class="form-group">
                    <label class="form-label">"Trakt Client Secret"</label>
                    <input
                        type="password"
                        class="form-input"
                        placeholder="Enter client secret..."
                        prop:value=move || api_keys.get().trakt_client_secret
                        on:input=move |ev| {
                            let value = event_target_value(&ev);
                            set_api_keys.update(|keys| keys.trakt_client_secret = value);
                        }
                    />
                    <small class="form-help">"Optional: Client secret for Trakt.tv integration"</small>
                </div>

                <div class="form-actions">
                    <button
                        class="btn btn-primary"
                        on:click=handle_save
                        disabled=move || is_saving.get()
                    >
                        {move || if is_saving.get() { "Saving..." } else { "Save API Keys" }}
                    </button>
                </div>
            </div>

            <div class="card" style="margin-top: 16px;">
                <h3>"Current API Keys Status"</h3>
                <div class="api-keys-status">
                    <div class="detail-item">
                        <span class="detail-label">"TMDB:"</span>
                        <span class="detail-value">{move || mask_key(&api_keys.get().tmdb_access_token)}</span>
                    </div>
                    <div class="detail-item">
                        <span class="detail-label">"Have I Been Pwned:"</span>
                        <span class="detail-value">{move || mask_key(&api_keys.get().hibp_api_key)}</span>
                    </div>
                    <div class="detail-item">
                        <span class="detail-label">"Fanart.tv:"</span>
                        <span class="detail-value">{move || mask_key(&api_keys.get().fanart_api_key)}</span>
                    </div>
                    <div class="detail-item">
                        <span class="detail-label">"OMDb:"</span>
                        <span class="detail-value">{move || mask_key(&api_keys.get().omdb_api_key)}</span>
                    </div>
                    <div class="detail-item">
                        <span class="detail-label">"Trakt Client ID:"</span>
                        <span class="detail-value">{move || mask_key(&api_keys.get().trakt_client_id)}</span>
                    </div>
                    <div class="detail-item">
                        <span class="detail-label">"Trakt Client Secret:"</span>
                        <span class="detail-value">{move || mask_key(&api_keys.get().trakt_client_secret)}</span>
                    </div>
                </div>
            </div>
        </section>
    }
}

/// Helper function to mask API keys
fn mask_key(key: &str) -> String {
    if key.is_empty() {
        "Not configured".to_string()
    } else if key.len() <= 8 {
        "*****".to_string()
    } else {
        format!("{}...{}", &key[..4], "*****")
    }
}

#[derive(Clone, Debug, serde::Deserialize, serde::Serialize)]
pub struct Indexer {
    pub id: String,
    pub name: String,
    pub protocol: String,
    pub base_url: String,
    pub enabled: bool,
}

#[derive(Clone, Debug, serde::Deserialize, serde::Serialize)]
pub struct DownloadClientConfig {
    pub id: String,
    pub name: String,
    pub client_type: String,
    pub host: String,
    pub port: u16,
    pub enabled: bool,
}

#[derive(Clone, Debug, serde::Deserialize, serde::Serialize)]
pub struct ApiKeysConfig {
    pub tmdb_access_token: String,
    pub tmdb_is_default: bool,
    pub hibp_api_key: String,
    pub hibp_is_default: bool,
    pub fanart_api_key: String,
    pub fanart_is_default: bool,
    pub omdb_api_key: String,
    pub omdb_is_default: bool,
    pub trakt_client_id: String,
    pub trakt_client_secret: String,
    pub trakt_is_default: bool,
}

impl Default for ApiKeysConfig {
    fn default() -> Self {
        Self {
            tmdb_access_token: String::new(),
            tmdb_is_default: true,
            hibp_api_key: String::new(),
            hibp_is_default: true,
            fanart_api_key: String::new(),
            fanart_is_default: true,
            omdb_api_key: String::new(),
            omdb_is_default: true,
            trakt_client_id: String::new(),
            trakt_client_secret: String::new(),
            trakt_is_default: true,
        }
    }
}

#[derive(Clone, Debug, serde::Deserialize, serde::Serialize)]
pub struct TestResult {
    pub success: bool,
    pub message: String,
}
