# ===========================================
# Stellarr Configuration
# ===========================================
# Copy this file to .env and customize as needed.
# Most settings have sensible defaults - you can run with minimal config.

# -------------------------------------------
# Server Configuration
# -------------------------------------------
STELLARR_SERVER_HOST=127.0.0.1
STELLARR_SERVER_PORT=8080

# -------------------------------------------
# Database Configuration
# -------------------------------------------
STELLARR_DATABASE_TYPE=sqlite
STELLARR_DATABASE_URL=sqlite://stellarr.db
STELLARR_DATABASE_MAX_CONNECTIONS=5

# For PostgreSQL (better for large libraries/multiple users):
# STELLARR_DATABASE_TYPE=postgres
# STELLARR_DATABASE_URL=postgresql://user:password@localhost/stellarr

# -------------------------------------------
# API Keys - ALL OPTIONAL
# -------------------------------------------
# Stellarr ships with default API keys that work out of the box.
# Add your own keys here to:
#   - Avoid rate limits if you have a large library
#   - Use your own quotas
#   - Support the services directly
#
# Leave blank or omit to use built-in defaults.

# TMDB (The Movie Database) - https://themoviedb.org/settings/api
# Free, used for movie/TV metadata and posters
STELLARR_TMDB_ACCESS_TOKEN=

# Have I Been Pwned - https://haveibeenpwned.com/API/Key
# Optional, for checking compromised credentials
STELLARR_HIBP_API_KEY=

# Fanart.tv - https://fanart.tv/get-an-api-key/
# Optional, for additional artwork (logos, backgrounds)
STELLARR_FANART_API_KEY=

# OMDb (Open Movie Database) - https://www.omdbapi.com/apikey.aspx
# Optional, for Rotten Tomatoes scores and extra metadata
STELLARR_OMDB_API_KEY=

# Trakt.tv - https://trakt.tv/oauth/applications
# Optional, for watchlist sync and scrobbling
STELLARR_TRAKT_CLIENT_ID=
STELLARR_TRAKT_CLIENT_SECRET=

# -------------------------------------------
# Logging
# -------------------------------------------
RUST_LOG=info,stellarr=debug
